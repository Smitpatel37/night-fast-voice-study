# Nextcloud WebDAV on GWDG Academic Cloud (Priyanka's account). Use an APP PASSWORD
# (Settings > Security > Devices & sessions), never the login password. WebDAV URL: Files > Settings (bottom left).
# Full WebDAV URL of the target folder; the folder is created if missing.
NEXTCLOUD_WEBDAV_URL=https://gwdg.files.academiccloud.de/remote.php/dav/files/<USERNAME>/NIGHT-FAST/Upload Audio Recording
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# Upload proxy
PORT=8787
# Comma-separated origins allowed to upload (the page's origin)
ALLOWED_ORIGINS=https://smitpatel37.github.io,http://localhost:8000
MAX_UPLOAD_MB=100
