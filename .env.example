# Nextcloud WebDAV (Priyanka's account). Use an APP PASSWORD (Nextcloud > Settings > Security), not the login password.
# Full WebDAV URL of the target folder; the folder is created if missing.
NEXTCLOUD_WEBDAV_URL=https://cloud.iff.ing.tu-bs.de/remote.php/dav/files/<USERNAME>/NightFast_Voice
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# Upload proxy
PORT=8787
# Comma-separated origins allowed to upload (the page's origin)
ALLOWED_ORIGINS=https://smitpatel37.github.io,http://localhost:8000
MAX_UPLOAD_MB=100
